# Routine state — wrapper writes this; agent reads it.
.cabin-state.json

# Generated each build by scripts/build.sh; do not commit
# (the workflow regenerates them in CI).
build-sha.txt
build-sha.js
diary/manifest.json

# Editor / OS detritus.
.DS_Store
*.swp
*.swo
*~

# Defensive: in case anyone ever adds Node tooling.
node_modules/

# Logs.
*.log

# Deploy pictures (Evan's 2026-10-03 note, "The pictures leave main"). CI
# publishes each deploy's set to the `previews` BRANCH; nothing but
# previews/baseline/ belongs on main, and this is the belt to that braces:
# a picture dropped in the working tree by accident cannot be committed back.
# `*` does not match `/`, so this pattern catches previews/<date>-<sha>*.png
# and leaves previews/baseline/*.png — one level deeper — alone, which is why
# there is no negation under it and why CI's `git add previews/baseline/` is
# unaffected.
previews/*.png

# Project-local Claude Code overrides (per-user, not shared).
.claude/settings.local.json

# Vendored asset pack zip (license forbids redistribution of the pack itself;
# the unpacked contents go in with credit, but not the archive).
Sprout Lands - Sprites - Basic pack.zip
*.zip

# Local-only Claude Code scheduling state
.claude/scheduled_tasks.lock
